# One-job smoke test of the NEW Sherpa 2-jet config before the 4x1M:
#   isron 200 v95d -> Sherpa 2-jet Born integrates + generates -> HepMC3 -> hepmc2fadgen ->
#   DELSIM (delphi-sim.sif, 95d BS) -> SDST on EOS. Confirms the new card + wrapper end-to-end.
# Submit (repo root, lxplus):  condor_submit generators/sherpa/condor_sherpa2jet_validate.sub
universe                = vanilla
executable              = generators/sherpa/run_sherpa2jet_prod.sh
arguments               = isron 200 $(ClusterId) $(Process) v95d 260607

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
MY.SendCredential       = true
getenv                  = False

requirements            = (HasSingularity =?= true)
request_memory          = 4GB
request_cpus            = 1
request_disk            = 10GB
+JobFlavour             = "workday"

log                     = condor_logs/sherpa2jet_validate_$(ClusterId).log
output                  = condor_logs/sherpa2jet_validate_$(ClusterId).$(Process).out
error                   = condor_logs/sherpa2jet_validate_$(ClusterId).$(Process).err
queue 1
