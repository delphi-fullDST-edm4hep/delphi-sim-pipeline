# One-off high-stat run: 2,000,000 EXTRA Pythia8-DEFAULT-shower isron 95d events.
#   10000 evt/job x 200 jobs = 2.0 M. Bigger jobs than the standard 2500 to cut job count (gentler on
#   the schedd). v95d => 1995/95d path + DELSIM v95d + 95d data beam-spot override (the 2-pass -STITL
#   flow in run_delsim_only.sh). closure_gen over-generates 10% automatically (gen 11000, DELSIM 10000).
#   Output APPENDS to the existing /eos/.../1995/91.2/MC/95d/SDST/pythia8_default_isron/260607
#   (new cluster id => distinct seeds + distinct filenames, no collision with the 2500-evt files there).
#   'tomorrow' flavour + 14h watchdog because a 10k-event DELSIM with the BS-override prerun runs ~6-9h.
# Submit (from the repo root, on lxplus):  condor_submit generators/pythia8_key4hep/condor_default_prod_95d_isron_2M.sub
universe                = vanilla
executable              = generators/pythia8_key4hep/run_default_prod.sh

NEV                     = 10000
arguments               = isron $(NEV) $(ClusterId) $(Process) v95d 260607

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
MY.SendCredential       = true
getenv                  = False

requirements            = (HasSingularity =?= true)
request_memory          = 4GB
request_cpus            = 1
request_disk            = 20GB
+JobFlavour             = "tomorrow"

# normal job ~6-9h; remove only a genuine hang (>14h)
periodic_remove         = (JobStatus == 2) && ((time() - JobCurrentStartDate) > 50400)

log                     = condor_logs/default95d2M_isron_$(ClusterId).log
output                  = condor_logs/default95d2M_isron_$(ClusterId).$(Process).out
error                   = condor_logs/default95d2M_isron_$(ClusterId).$(Process).err

queue 200
