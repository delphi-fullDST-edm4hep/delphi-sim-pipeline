# 100k Z->bb, fix1 only (status 11, DELSIM lifetime table, LUDECV FALSE): 20 jobs x 5000 events.
# Self-contained: gen -> hepmc2fadgen(fix) -> DELSIM(.sif, LUDECV) -> edm4hep -> EOS.
universe                = vanilla
executable              = run_btag_job.sh
# args: <nev> <process> <ludecv> <eos_dest> <seed_base>   (seed = base + process, disjoint from fix1)
arguments               = 5000 $(Process) FALSE /eos/experiment/eealliance/Users/zhangj/edm4hepSimBTagging/fix1_only 2000000
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
MY.SendCredential       = true
getenv                  = False
requirements            = (HasSingularity =?= true)
request_memory          = 4GB
request_cpus            = 1
request_disk            = 15GB
+JobFlavour             = "tomorrow"
output                  = /afs/cern.ch/work/z/zhangj/btag_condorOut/fix1_$(ClusterId)_$(Process).out
error                   = /afs/cern.ch/work/z/zhangj/btag_condorOut/fix1_$(ClusterId)_$(Process).err
log                     = /afs/cern.ch/work/z/zhangj/btag_condorOut/fix1_$(ClusterId).log
queue 20
