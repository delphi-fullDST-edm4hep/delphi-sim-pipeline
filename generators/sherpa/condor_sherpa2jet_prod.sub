# Sherpa fixed-order 2-jet (e+e- -> q qbar, no merging) Z->hadrons, ISR on/off, 94c/95d, with data
# beam-spot override on BOTH versions. 1,000,000 events/stream = 5000 evt/job x 200 jobs.
# 24h watchdog from the start (DELSIM is the slow step; same lesson as the pythia8/kk2f runs).
# Submit one stream at a time with -append (do NOT edit this file):
#   condor_submit generators/sherpa/condor_sherpa2jet_prod.sub -a 'VARIANT=isron'  -a 'PVER=v94c'
#   condor_submit generators/sherpa/condor_sherpa2jet_prod.sub -a 'VARIANT=isroff' -a 'PVER=v94c'
#   condor_submit generators/sherpa/condor_sherpa2jet_prod.sub -a 'VARIANT=isron'  -a 'PVER=v95d'
#   condor_submit generators/sherpa/condor_sherpa2jet_prod.sub -a 'VARIANT=isroff' -a 'PVER=v95d'
universe                = vanilla
executable              = generators/sherpa/run_sherpa2jet_prod.sh

NEV                     = 5000
VARIANT                 = isron
PVER                    = v94c
arguments               = $(VARIANT) $(NEV) $(ClusterId) $(Process) $(PVER) 260607

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
MY.SendCredential       = true
getenv                  = False

requirements            = (HasSingularity =?= true)
request_memory          = 4GB
request_cpus            = 1
request_disk            = 10GB
+JobFlavour             = "tomorrow"

periodic_remove         = (JobStatus == 2) && ((time() - JobCurrentStartDate) > 86400)

log                     = condor_logs/sherpa2jet_$(VARIANT)_$(PVER)_$(ClusterId).log
output                  = condor_logs/sherpa2jet_$(VARIANT)_$(PVER)_$(ClusterId).$(Process).out
error                   = condor_logs/sherpa2jet_$(VARIANT)_$(PVER)_$(ClusterId).$(Process).err

queue 200
