# KK2f e+e- -> q qbar hadronic, Z pole, ISR on/off, 94c/95d, with data beam-spot override.
#   1,000,000 events/stream = 5000 evt/job x 200 jobs.  Smaller jobs + 24h watchdog from the
#   start (lesson from the pythia8 5M run: 10k/job overran 14h on slow nodes; kk2f adds grid-build
#   overhead so 5k/job is the safe size).  Gen in delphi-kk2f.sif, DELSIM in delphi-sim.sif.
# Submit one stream at a time with -append (NOT by editing this file):
#   condor_submit generators/kk2f/condor_kk2f_prod.sub -a 'VARIANT=isron'  -a 'PVER=v94c'
#   condor_submit generators/kk2f/condor_kk2f_prod.sub -a 'VARIANT=isroff' -a 'PVER=v94c'
#   condor_submit generators/kk2f/condor_kk2f_prod.sub -a 'VARIANT=isron'  -a 'PVER=v95d'
#   condor_submit generators/kk2f/condor_kk2f_prod.sub -a 'VARIANT=isroff' -a 'PVER=v95d'
universe                = vanilla
executable              = generators/kk2f/run_kk2f_prod.sh

NEV                     = 5000
VARIANT                 = isron
PVER                    = v94c
arguments               = $(VARIANT) $(NEV) $(ClusterId) $(Process) $(PVER) 260607

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
MY.SendCredential       = true
getenv                  = False

requirements            = (HasSingularity =?= true)
request_memory          = 4GB
request_cpus            = 1
request_disk            = 20GB
+JobFlavour             = "tomorrow"

periodic_remove         = (JobStatus == 2) && ((time() - JobCurrentStartDate) > 86400)

log                     = condor_logs/kk2f_$(VARIANT)_$(PVER)_$(ClusterId).log
output                  = condor_logs/kk2f_$(VARIANT)_$(PVER)_$(ClusterId).$(Process).out
error                   = condor_logs/kk2f_$(VARIANT)_$(PVER)_$(ClusterId).$(Process).err

queue 200
